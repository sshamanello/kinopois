# Kinopoisk.dev API Key
KINOPOISK_API_KEY=your_api_key_here

# Base directories
DATA_DIR=data
POSTERS_DIR=data/posters
COLLAGES_DIR=data/collages
CACHE_DIR=data/cache

# Collage settings
COLLAGE_TILE_WIDTH=500
COLLAGE_TILE_HEIGHT=750
COLLAGE_MAX_PER_GENRE=

# Watermark / marking
WATERMARK_TEXT=@TopTrailer82Bot
WATERMARK_POSITION=bottom

# Export settings
BOT_URL=https://t.me/TopTrailer82Bot
BASE_IMAGE_URL=https://sshamanello.ru/collages

# ── Google Sheets integration ──────────────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create a Service Account → download JSON key
# 3. Share your spreadsheet with the service account email (Editor access)
# 4. Fill in the values below:
GOOGLE_CREDS_FILE=credentials/google-service-account.json
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_TAB=pins

# ── Pinterest (используется в n8n workflow) ────────────────────────────────
# Токен из Pinterest Developer Portal → Apps → Access token
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Fallback board_id если в pins.csv поле board_id пустое
PINTEREST_BOARD_ID=your_default_board_id_here

# ── Autopilot scheduler (fully autonomous mode) ────────────────────────────
# 1 = включить автопилот, 0 = выключить
AUTOPILOT_ENABLED=0
# Лимит новых загрузок в сутки (учитывает лимит API Kinopoisk)
AUTOPILOT_DOWNLOAD_LIMIT_PER_DAY=200
# Сколько публикационных слотов в день
AUTOPILOT_POSTS_PER_DAY=3
# Часы слотов публикации (локальное время сервера)
AUTOPILOT_SLOT_HOURS=10,15,20
# Случайный сдвиг каждого слота в минутах
AUTOPILOT_SLOT_JITTER_MIN=20
# Частота проверки цикла автопилота
AUTOPILOT_LOOP_SLEEP_SEC=30
# Файл состояния автопилота (не удалять между перезапусками)
AUTOPILOT_STATE_FILE=data/cache/autopilot_state.json
# Команда внешней публикации Pinterest (stdin получает JSON job)
AUTOPILOT_PUBLISH_COMMAND=
# Автосинк после daily harvest
AUTOPILOT_SYNC_QUEUE=1
AUTOPILOT_SYNC_SHEETS=1

# ── Telegram alerts (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
