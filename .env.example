# Kinopoisk.dev API Key
KINOPOISK_API_KEY=your_api_key_here
KINOPOISK_API_URL=https://api.poiskkino.dev/v1.4/movie
# Optional TLS/DNS fallback pool for api.poiskkino.dev, comma-separated.
# Example:
# KINOPOISK_RESOLVE_IPS=141.144.239.27,130.61.200.81,85.192.56.241,109.107.189.31,77.223.96.106,5.53.125.171
KINOPOISK_RESOLVE_IPS=

# Base directories (all local — no remote server)
DATA_DIR=data
POSTERS_DIR=data/posters
COLLAGES_DIR=data/collages
CACHE_DIR=data/cache
FRAMED_POSTERS_DIR=data/posters_framed
FRAMED_SOURCE_POSTERS_DIR=data/posters_clean
PUBLISH_IMAGES_DIR=data/publish/ready

# Collage settings
COLLAGE_TILE_WIDTH=500
COLLAGE_TILE_HEIGHT=750
COLLAGE_MAX_PER_GENRE=

# Watermark / marking
WATERMARK_TEXT=@TopTrailer82Bot
WATERMARK_POSITION=bottom

# Export settings — local paths (Pinterest uses base64 upload, no public URL needed)
BOT_URL=https://t.me/TopTrailer82Bot
BASE_IMAGE_URL=data/collages
POSTERS_BASE_URL=data/posters
FRAMED_POSTERS_BASE_URL=data/posters_framed
PUBLISH_IMAGES_BASE_URL=data/publish/ready
PUBLISH_IMAGES_CLEANUP_ENABLED=1
PUBLISH_IMAGES_RETENTION_DAYS=21
USE_FRAMED_POSTERS=1
FRAMED_REFRESH_SOURCE=1
FRAMED_FORCE_REGENERATE=1

# ── Pinterest (used by n8n workflow) ────────────────────────────────────────
# Token from Pinterest Developer Portal → Apps → Access token
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Fallback board_id if pins.csv board_id field is empty
PINTEREST_BOARD_ID=your_default_board_id_here

# ── Postgres queue (used by n8n and kinopois) ────────────────────────────────
QUEUE_DB_HOST=127.0.0.1
QUEUE_DB_PORT=5432
QUEUE_DB_NAME=pinterest
QUEUE_DB_USER=pinterest
QUEUE_DB_PASSWORD=your_queue_db_password_here
QUEUE_DB_SSLMODE=disable

# ── Autopilot scheduler (fully autonomous mode) ────────────────────────────
# 1 = enable autopilot, 0 = disable
AUTOPILOT_ENABLED=0
# Daily download limit (respects Kinopoisk API limits)
AUTOPILOT_DOWNLOAD_LIMIT_PER_DAY=200
# Publish slots per day
AUTOPILOT_POSTS_PER_DAY=3
AUTOPILOT_PUBLISH_ATTEMPTS_PER_SLOT=5
AUTOPILOT_ENABLE_PUBLISH=1
# Publish slot hours (local server time)
AUTOPILOT_SLOT_HOURS=10,15,20
# Random jitter per slot in minutes
AUTOPILOT_SLOT_JITTER_MIN=20
# Autopilot loop check interval in seconds
AUTOPILOT_LOOP_SLEEP_SEC=30
# Autopilot state file (do not delete between restarts)
AUTOPILOT_STATE_FILE=data/cache/autopilot_state.json
# External publish command (stdin receives JSON job)
AUTOPILOT_PUBLISH_COMMAND=
# Auto-sync after daily harvest
AUTOPILOT_SYNC_QUEUE=1

# ── Telegram alerts (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=