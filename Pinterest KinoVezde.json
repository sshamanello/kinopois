          "name": "Postgres Pinterest Local"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE kinopois_pins SET posted='FALSE', publish_status='failed', status='failed', error_reason='Pinterest request failed' WHERE id='{{ $('Pick one publishable row').item.json.id }}' RETURNING *;",
        "options": {}
      },
      "id": "e4319227-6ba9-4704-a165-a240a55d0e5a",
