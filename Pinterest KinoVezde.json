      "parameters": {
        "jsCode": "const ready = items.filter((item) => {\n  const row = item.json;\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  const upload = String(row.vds_upload_status ?? '').trim().toLowerCase();\n  return status === 'ready'\n    && upload === 'uploaded'\n    && Boolean(row.public_image_url || row.image_url)\n    && Boolean(row.id);\n});\n\nreturn ready.slice(0, 1);\n"
      },
