{
  "name": "Pinterest KinoVezde Base64",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 5,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "f895eb28-46d5-433f-9060-6d704378efb1",
      "name": "Every 5 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -2048,
        272
      ],
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const row = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'http://127.0.0.1:8788/queue/next?limit=1',\n  json: true,\n});\nif (!row || !row.id) {\n  return [];\n}\nreturn [{ json: row }];\n"
      },
      "id": "7dcd00d8-7b43-46f2-9cc6-da81037830c0",
      "name": "Get ready rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1808,
        192
      ],
      "continueOnFail": false,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const ready = items.filter((item) => {\n  const row = item.json;\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  const upload = String(row.vds_upload_status ?? '').trim().toLowerCase();\n  return status === 'ready'\n    && upload === 'uploaded'\n    && Boolean(row.id)\n    && Boolean(row.title || row.original_title || row.description);\n});\n\nreturn ready.slice(0, 1);\n"
      },
      "id": "2012fe65-93e7-4cd7-9a26-3865ba5acbfd",
      "name": "Pick one publishable row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        192
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ \"/home/nick/kinopois/data/fresh_run/posters_framed/\" + $json.id + \".jpg\" }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "8c978234-ff20-4c76-9e5b-1398a11b2001",
      "name": "Read image file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        -1360,
        192
      ]
    },
    {
      "parameters": {
        "mode": "binaryToJson",
        "setAllData": false,
        "sourceKey": "data",
        "destinationKey": "image_base64",
        "options": {
          "keepAsBase64": true,
          "keepSource": false
        }
      },
      "id": "ab55f49e-4376-41bc-b78f-4e5166d908e9",
      "name": "Convert image to base64",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.1,
      "position": [
        -1144,
        192
      ]
    },
    {
      "parameters": {
        "pinBoardId": "1085930597590767480",
        "pinTitle": "={{ (($('Pick one publishable row').item.json.title || $('Pick one publishable row').item.json.original_title || 'Фильм') + ' | KinoVezde').toString().slice(0, 100) }}",
        "pinDescription": "={{ (($('Pick one publishable row').item.json.description || 'Сохраните этот пин с постером фильма.').toString().slice(0, 500)) }}",
        "pinLink": "={{ $('Pick one publishable row').item.json.kp_url || 'https://t.me/TopTrailer82Bot' }}",
        "mediaSource": "base64",
        "base64Image": "={{ $json.image_base64 }}"
      },
      "id": "c63e87de-e969-41ac-96f3-cb67fefc5ea1",
      "name": "Create a pin",
      "type": "n8n-nodes-pin-interest.pinInterest",
      "typeVersion": 1,
      "position": [
        -1312,
        192
      ],
      "credentials": {
        "pinInterestOAuth2Api": {
          "id": "2J7VZQl3ain7Cewo",
          "name": "KinoVezde"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "pin_created",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8d643710-ed01-440d-84d8-271b27c5637c",
      "name": "Pinterest success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1072,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const publishRow = $('Pick one publishable row').item.json;\nconst pinId = String(items[0]?.json?.id ?? items[0]?.json?.pin_id ?? '').trim();\nif (!publishRow?.job_id) {\n  throw new Error('Missing job_id for published row');\n}\nif (!pinId) {\n  throw new Error('Missing Pinterest pin id');\n}\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://127.0.0.1:8788/queue/posted',\n  headers: { 'Content-Type': 'application/json' },\n  body: { job_id: publishRow.job_id, pin_id: pinId },\n  json: true,\n});\nreturn [{ json: { ok: true, job_id: publishRow.job_id, pin_id: pinId } }];\n"
      },
      "id": "07bf04ae-3087-42f9-948b-8d0d78f7a561",
      "name": "Mark row published",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const publishRow = $('Pick one publishable row').item.json;\nconst errorText = String(items[0]?.json?.error?.message || items[0]?.json?.error || items[0]?.json?.message || 'unknown Pinterest error').trim();\nif (!publishRow?.job_id) {\n  throw new Error('Missing job_id for failed row');\n}\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://127.0.0.1:8788/queue/failed',\n  headers: { 'Content-Type': 'application/json' },\n  body: { job_id: publishRow.job_id, error: errorText },\n  json: true,\n});\nreturn [{ json: { ok: true, job_id: publishRow.job_id, error: errorText } }];\n"
      },
      "id": "e4319227-6ba9-4704-a165-a240a55d0e5a",
      "name": "Mark row failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        288
      ]
    },
