{
  "name": "Pinterest KinoVezde Base64",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 5,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "f895eb28-46d5-433f-9060-6d704378efb1",
      "name": "Every 5 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -2048,
        272
      ],
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM kinopois_pins WHERE publish_status = 'ready' AND upper(coalesce(posted, '')) <> 'TRUE' AND coalesce(id::text, '') <> '' AND coalesce(title, original_title, description, '') <> '' ORDER BY id LIMIT 1;",
        "options": {}
      },
      "id": "7dcd00d8-7b43-46f2-9cc6-da81037830c0",
      "name": "Get ready rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1808,
        192
      ],
      "credentials": {
        "postgres": {
          "id": "PgLocalCred2026A1",
          "name": "Postgres Pinterest Local"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ready = items.filter((item) => {\n  const row = item.json;\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  return status === 'ready'\n    && Boolean(row.id)\n    && Boolean(row.title || row.original_title || row.description);\n});\n\nreturn ready.slice(0, 1);\n"
      },
      "id": "2012fe65-93e7-4cd7-9a26-3865ba5acbfd",
      "name": "Pick one publishable row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        192
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ \"/home/nick/kinopois/data/fresh_run/posters_framed/\" + $json.id + \".jpg\" }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "8c978234-ff20-4c76-9e5b-1398a11b2001",
      "name": "Read image file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        -1360,
        192
      ]
    },
    {
      "parameters": {
        "mode": "binaryToJson",
        "setAllData": false,
        "sourceKey": "data",
        "destinationKey": "image_base64",
        "options": {
          "keepAsBase64": true,
          "keepSource": false
        }
      },
      "id": "ab55f49e-4376-41bc-b78f-4e5166d908e9",
      "name": "Convert image to base64",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.1,
      "position": [
        -1144,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/pins",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pinInterestOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  board_id: \"1085930597590767480\",\n  title: ((($('Pick one publishable row').item.json.title || $('Pick one publishable row').item.json.original_title || 'Фильм') + ' | KinoVezde').toString().slice(0, 100)),\n  description: ((($('Pick one publishable row').item.json.description || 'Сохраните этот пин с постером фильма.').toString().slice(0, 500))),\n  link: $('Pick one publishable row').item.json.tg_url || $('Pick one publishable row').item.json.link || 'https://t.me/TopTrailer82Bot',\n  media_source: {\n    source_type: \"image_base64\",\n    content_type: \"image/jpeg\",\n    data: $json.image_base64\n  }\n}) }}",
        "options": {}
      },
      "id": "c63e87de-e969-41ac-96f3-cb67fefc5ea1",
      "name": "Create a pin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1312,
        192
      ],
      "credentials": {
        "pinInterestOAuth2Api": {
          "id": "2J7VZQl3ain7Cewo",
          "name": "KinoVezde"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "pin_created",
              "leftValue": "={{ $json.error?.message || $json.error || \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8d643710-ed01-440d-84d8-271b27c5637c",
      "name": "Pinterest success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1072,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE kinopois_pins SET posted='TRUE', publish_status='published', status='posted', pin_id='{{ $('Create a pin').item.json.id || $('Create a pin').item.json.pin_id || $('Create a pin').item.json.pinId || $('Create a pin').item.json.body?.id || $('Create a pin').item.json.body?.pin_id || $('Create a pin').item.json.body?.pinId || $('Create a pin').item.json.data?.id || $('Create a pin').item.json.data?.pin_id || $('Create a pin').item.json.data?.pinId || '' }}', published_at='{{ $now }}', posted_at=COALESCE(NULLIF(posted_at, ''), '{{ $now }}'), error_reason='' WHERE id='{{ $('Pick one publishable row').item.json.id }}' RETURNING *;",
        "options": {}
      },
      "id": "07bf04ae-3087-42f9-948b-8d0d78f7a561",
      "name": "Mark row published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
